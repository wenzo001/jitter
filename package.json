{
  "name": "jitter",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "测试 curl，并定时（每天窗口）或循环（固定间隔）调用它",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --outfile dist/jitter src/index.ts"
  },
  "dependencies": {
    "elysia": "^1.4.31",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
